<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui_Launcher.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <!-- Image with Border and Pointer -->
            <Border Stroke="Gray"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    WidthRequest="300"
                    HeightRequest="200"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0">

                <Grid WidthRequest="300" HeightRequest="200">
                    <!-- Base Image -->
                    <Image x:Name="MyImage"
                           Source="dotnet_bot.png"
                           Aspect="AspectFit"
                           WidthRequest="300"
                           HeightRequest="200" />

                    <!-- Pointer Overlay -->
                    <Border x:Name="CursorPointer"
                            Stroke="#B3A6EBC1"
                            StrokeThickness="2"
                            BackgroundColor="Transparent"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            TranslationX="0"
                            TranslationY="0" />
                </Grid>
            </Border>

            <!-- DEBUGGING : Cursor Position Labels & Sliders -->
            <Label x:Name="CursorXPositionLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Text="XPosition of cursor: 0.5" />

            <Slider x:Name="xPositionOfCursor"
                    Minimum="0.0"
                    Maximum="1.0"
                    Value="0.5"
                    ValueChanged="CursorXPosition_ValueChanged"
                    Margin="0,10"/>

            <Label x:Name="CursorYPositionLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Text="YPosition of cursor: 0.5" />

            <Slider x:Name="yPositionOfCursor"
                    Minimum="0.0"
                    Maximum="1.0"
                    Value="0.5"
                    ValueChanged="CursorYPosition_ValueChanged"
                    Margin="0,10"/>

            <!-- DEBUGGING : debug messages label-->
            <Label x:Name="DebuggingLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Text="Debugging message" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
