<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Launcher.MainPage"
             Title="">


    <Grid HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <!-- Your full-screen image layout here -->
        <!--  Image with Border and Pointer  -->
        <Border Stroke="Gray"
            StrokeThickness="2"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Padding="0">
            <Grid HorizontalOptions="Fill"
                 VerticalOptions="Fill">
                <!-- Base Image -->
                <Image x:Name="MyImage"
                   Source="dotnet_bot.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>

                <!-- Pointer Overlay -->
                <Border x:Name="Cursor"
                    Stroke="#B3A6EBC1"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="50"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    TranslationX="0"
                    TranslationY="0"/>
            </Grid>
        </Border>

        <!--  NOT USED 
            DEBUGGING : Cursor Position Labels & Sliders
            <Label x:Name="CursorXPositionLabel" FontSize="14" HorizontalOptions="Center" Text="XPosition of cursor:"/>
            <Slider x:Name="xPositionOfCursor" Minimum="0" Maximum="300" Value="0" ValueChanged="CursorXPosition_ValueChanged" Margin="0,10"/>
            <Label x:Name="CursorYPositionLabel" FontSize="14" HorizontalOptions="Center" Text="YPosition of cursor: 0.5"/>
            <Slider x:Name="yPositionOfCursor" Minimum="0" Maximum="200" Value="0" ValueChanged="CursorYPosition_ValueChanged" Margin="0,10"/>
            -->

        <!--  NOT USED
            DEBUGGING for ANDROID: debug messages label
            <Label x:Name="DebuggingLabel" FontSize="14" HorizontalOptions="Center" Text="Debugging message"/>
            -->

    </Grid>

</ContentPage>
